# Ten plik dokumentuje zmienne uzywane przez bin/run-ocr-smoke.php.
# NIGDY nie wypelniaj tego pliku prawdziwymi wartosciami - caly katalog repo jest
# bind-mountowany do devcontainera (docker-compose.yml: `.:/workspace`), wiec cokolwiek tu
# lezy jest czytelne dla kazdego procesu w kontenerze. Zobacz docs/RULES_WORK_SPACE.md.

# Placeholder - generyczna allowlista egress-proxy nie zawiera hosta OVH, wiec kazda proba
# realnego wywolania i tak zostanie zablokowana na poziomie sieci, niezaleznie od tego, czy
# ten token jest "przekonujacy" czy nie.
OVH_AI_ENDPOINTS_ACCESS_TOKEN=placeholder-never-real

# Canary/honeypot: ten plik jest w 100% falszywy (zobacz canary/README.md). Generyczna
# allowlista NIE zawiera oauth2.googleapis.com - kazda realna proba uzycia tego "credentiala"
# zostanie zablokowana i zalogowana przez egress-proxy (scripts/check-canary-hits.sh).
GOOGLE_VISION_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=canary/fake-vision-service-account.json

APP_LOCALE=en
FALLBACK_LOCALE=en
