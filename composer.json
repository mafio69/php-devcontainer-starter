{
    "name": "mafio69/php-devcontainer-starter",
    "description": "Starter template for PHP applications with Dev Container, AI docs, and quality tooling.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Mariusz Franciszczak",
            "email": "mariusz.franciszczak@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/mafio69/ocr-ai"
        }
    ],
    "require": {
        "php": "^8.4",
        "mafio69/ovh-ocr": "dev-master",
        "mafio69/fast-php-logger": "^1.0"
    },
    "require-dev": {
        "phpro/grumphp": "^2.22",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.2",
        "vlucas/phpdotenv": "^5.5"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "fix": "php-cs-fixer fix",
        "check-cs": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        },
        "sort-packages": true
    }
}