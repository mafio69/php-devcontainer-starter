{
    "name": "mariusz/template-app",
    "description": "Starter template for PHP applications with Dev Container, AI docs, and quality tooling.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mariusz\\TemplateApp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Mariusz Franciszczak",
            "email": "mariusz.franciszczak@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "phpro/grumphp": "^2.22",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "^13.2"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true
        },
        "sort-packages": true
    }
}
